# =============================================================================
# NovaMart Environment Variables & Deployment Configuration
# =============================================================================

# Server Runtime (Node / Express)
PORT=3000
# NODE_ENV is set by the hosting platform. `npm run dev` defaults to development.
# NODE_ENV=production

# CORS Security: Comma-separated list of allowed origins in production
# Leave blank for same-origin only, or set your production frontend domain:
# Example: https://novamart.yourdomain.com
ALLOWED_ORIGIN=

# Number of trusted proxy hops in front of the server (Render/Railway = 1).
# Without this, every visitor shares the proxy's IP for rate limiting.
# Leave blank when the server is exposed directly to the internet.
TRUST_PROXY=

# Server-side Firebase access for authenticated, atomic checkout
# Use the Firebase project ID and a service account JSON with Firestore read/write access.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Gemini API (Required for Voice AI Search & Audio Transcription on /api/transcribe)
# Server-side ONLY. Never expose with VITE_ prefix.
GEMINI_API_KEY=

# Client Application (Vite Build-time Configuration)
# Note: VITE_ variables are bundled into the public client JavaScript during `npm run build`
VITE_STORE_NAME=NovaMart
VITE_CURRENCY_SYMBOL=$
