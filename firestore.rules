rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'wilberofficial2001@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check / connection test doc
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile documents: strictly owned, no privilege escalation
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // On create, non-admins can only set role to 'customer'
      allow create: if isOwner(userId) && isValidId(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == 'customer' || 
        isAdmin()
      );
      
      // On update, clients cannot elevate role; only admins can modify role
      allow update: if isOwner(userId) && isValidId(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role == resource.data.role || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // Products catalog: publicly readable, only admins can manage products.
    // Customers can only decrement stock as part of an order.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() && isValidId(productId);
      allow update: if isValidId(productId) && (
        isAdmin() || (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock is number &&
          request.resource.data.stock >= 0 &&
          request.resource.data.stock < resource.data.stock
        )
      );
    }

    // Orders: single get by ID allowed for tracking; list restricted to owner or admin.
    // Create strictly enforces valid schema and positive total.
    // Updates/cancellations restricted to admin.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && (
        (!isSignedIn() && request.resource.data.userId == 'guest') ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid)
      ) &&
      request.resource.data.keys().hasAll(['id', 'orderNumber', 'items', 'total', 'status', 'date']) &&
      request.resource.data.total is number &&
      request.resource.data.total >= 0 &&
      request.resource.data.status == 'Pending';
      
      allow update, delete: if isAdmin();
    }
  }
}
